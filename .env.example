# ==============================================================================
# AI-Powered Personal Diet Planner with Cloud Storage - Environment Variables
# ==============================================================================

# Server Configuration
PORT=8000
CLOUD_ENVIRONMENT=development
CLOUD_REGION="us-east-1 (Cloud Native / Agnostic)"

# Authentication & Security
# Generate a strong 64-character hex key in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=super-secret-cloud-computing-key-2026-diet-planner
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloud Database Configuration
# Defaults to SQLite database file on local/container volume. Pluggable to Cloud Firestore / Postgres
CLOUD_DB_PATH=diet_planner_cloud.db
DATABASE_PROVIDER=cloud_database_sqlite_managed

# Cloud Object Storage Configuration
# Local storage simulation bucket folder, or pluggable S3/Firebase Storage bucket URI
STORAGE_BUCKET_DIR=cloud_storage_bucket
STORAGE_PROVIDER=cloud_object_storage_simulated

# External AI Service (Optional - System automatically falls back to offline rule-based AI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Environment Variables (Vite)
# VITE_API_URL=http://localhost:8000/api
# VITE_ROOT_URL=http://localhost:8000
